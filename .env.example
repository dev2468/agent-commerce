# Razorpay — Orders, Checkout and Payment Links are real with a test key.
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXX
RAZORPAY_KEY_SECRET=your_key_secret_here

# The agent's brain. OpenRouter is preferred when both are set; the runner
# falls back to the Google SDK, then to a deterministic planner, and always
# says in the transcript which one actually ran.
OPENROUTER_API_KEY=sk-or-v1-your_key_here
OPENROUTER_MODEL=google/gemini-3.7-flash
GOOGLE_API_KEY=your_gemini_api_key_here

JWT_SECRET=change-this-to-a-long-random-string

# Razorpay test mode allows only 30 payment links for the life of the account,
# so links are created on demand. Set to 1 to mint one with every purchase.
RZP_AUTO_LINK=0

# Only for agent/run.py (the standalone ADK REPL). The browser console does not
# need these — it drives an agent that already has a reserve and a passport.
AGENT_ID=agent_XXXXXXXXXXXX
AGENT_SECRET=your_agent_secret_here
